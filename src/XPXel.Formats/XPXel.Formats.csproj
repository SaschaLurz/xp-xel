<!--
  XPXel.Formats - image import/export and native project (.xpxel) serialization.

  ARCHITECTURAL RULE: BCL + XPXel.Core only. No UI, and deliberately NO native imaging
  library (see Png/PngCodec.cs for why the PNG implementation is pure managed code).

  This is the project that grows every time XP-xel learns a new file type. The growth
  mechanism is ImageFormatRegistry: a new format is a new class plus one registration,
  never a change to existing code.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XPXel.Formats</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPXel.Core\XPXel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The codecs are internal because nothing outside this project should depend on their
         shape. The tests need them: verifying the PNG decoder means constructing files with
         colour types and bit depths the encoder never writes. -->
    <InternalsVisibleTo Include="XPXel.Formats.Tests" />
  </ItemGroup>

</Project>

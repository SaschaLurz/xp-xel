<!--
  The application shell.

  This is a UserControl rather than a Window on purpose: the desktop head wraps it in a
  window, and the browser head hosts it directly, so the entire user interface is shared
  across every platform and only the frame differs.

  The menu, the tool options bar and the status bar are fixed. Everything between them is a
  DockControl: the toolbox, layers and colour panels and the document tabs are all dockables
  that the artist can drag, tab together, float into their own windows, pin to an edge or
  close. Their arrangement is built by XpDockFactory on first run and restored from settings
  afterwards.

  The whole thing sits in a Grid so a modal dialog can be overlaid on top of it, which is how
  XP-xel does dialogs everywhere (the browser has no child windows).

  Note that the panel DataTemplates live in App.axaml, not here. A panel dragged out into a
  floating window is in a different window and would not see templates declared on this
  control.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:docking="using:XPXel.UI.Docking"
             xmlns:services="using:XPXel.UI.Services"
             xmlns:vm="using:XPXel.UI.ViewModels"
             x:Class="XPXel.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportAnimationCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DeselectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+I" Command="{Binding InvertSelectionCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding FreeTransformCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+C" Command="{Binding ChangeCanvasSizeCommand}" />
    <!-- Ctrl+A is not here either, for the same reason as the clipboard keys: it means "all
         the pixels" on the canvas and "all the words" inside text, and a KeyBinding cannot
         tell the two apart. See MainView.axaml.cs.

         The bare-key shortcuts - X to swap colours, and one letter per tool - are handled in
         code-behind rather than declared here. A KeyBinding fires wherever the key is
         pressed, so binding "X" would swap the drawing colours in the middle of renaming a
         layer to "Axe". The code-behind checks first that nothing is being typed into.

         Ctrl+C, Ctrl+X and Ctrl+V are there for the same reason and a sharper one: a text box
         has its own meaning for all three, and stealing them would make it impossible to paste
         a name into the layers panel. -->
  </UserControl.KeyBindings>

  <Grid Background="{DynamicResource XpAppBackgroundBrush}">

    <DockPanel>

      <!-- ============================================================================
           Menu
           ============================================================================ -->
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="_File">
          <MenuItem Header="_New…" InputGesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
          <MenuItem Header="_Open…" InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
          <Separator />
          <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
          <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
          <Separator />
          <MenuItem Header="_Export Image…" InputGesture="Ctrl+E" Command="{Binding ExportCommand}" />
          <MenuItem Header="Export _Animation…" InputGesture="Ctrl+Shift+E" Command="{Binding ExportAnimationCommand}" />
          <Separator />
          <MenuItem Header="Open _Backups Folder"
                    Command="{Binding OpenBackupFolderCommand}"
                    IsEnabled="{Binding IsAutosaveAvailable}"
                    ToolTip.Tip="XP-xel keeps the last three copies of every open document, taken every three minutes" />
          <Separator />
          <MenuItem Header="_Close Document" InputGesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
        </MenuItem>

        <MenuItem Header="_Edit">
          <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
          <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
          <Separator />
          <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Command="{Binding CutCommand}"
                    ToolTip.Tip="Copy what is marked and clear it" />
          <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding CopyCommand}"
                    ToolTip.Tip="Copy what is marked, both for XP-xel and for other programs" />
          <MenuItem Header="_Paste" InputGesture="Ctrl+V" Command="{Binding PasteCommand}"
                    ToolTip.Tip="Paste pixels, an image from another program, or text as a text layer" />
          <Separator />
          <MenuItem Header="_Erase Marked Pixels" InputGesture="Delete"
                    Command="{Binding EraseSelectionCommand}"
                    ToolTip.Tip="Clear what is marked on the active layer. Backspace does the same" />
          <Separator />
          <MenuItem Header="S_wap Colours" InputGesture="X" Command="{Binding SwapColorsCommand}" />
        </MenuItem>

        <MenuItem Header="_Image">
          <MenuItem Header="_Canvas Size…" InputGesture="Ctrl+Alt+C" Command="{Binding ChangeCanvasSizeCommand}" />
          <MenuItem Header="Crop to _Selection" Command="{Binding CropToSelectionCommand}" />
          <Separator />
          <MenuItem Header="Free _Transform" InputGesture="Ctrl+T"
                    Command="{Binding FreeTransformCommand}"
                    ToolTip.Tip="Scale, flip or turn the marked pixels — or everything on the marked layers when nothing is marked. Enter applies, Escape cancels" />
        </MenuItem>

        <MenuItem Header="_Select">
          <MenuItem Header="Select _All" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
          <MenuItem Header="_Deselect" InputGesture="Ctrl+D" Command="{Binding DeselectCommand}"
                    ToolTip.Tip="Escape does the same, as does clicking the empty space beside the picture" />
          <MenuItem Header="_Invert Selection" InputGesture="Ctrl+Shift+I" Command="{Binding InvertSelectionCommand}" />
          <Separator />
          <MenuItem Header="_Move Selected Pixels"
                    Command="{Binding MoveSelectedPixelsCommand}"
                    ToolTip.Tip="Lift the marked pixels and drag them. Enter places them, Escape puts them back" />
          <MenuItem Header="_Transform Selection…"
                    Command="{Binding TransformSelectionCommand}"
                    ToolTip.Tip="Resize, flip or turn the marks themselves. The artwork underneath is not touched" />
        </MenuItem>

        <MenuItem Header="_Animation">
          <MenuItem Header="_Add Frame" Command="{Binding Timeline.AddFrameCommand}" />
          <MenuItem Header="_Duplicate Frame" Command="{Binding Timeline.DuplicateFrameCommand}" />
          <MenuItem Header="De_lete Frame" Command="{Binding Timeline.DeleteFrameCommand}" />
          <Separator />
          <MenuItem Header="Move Frame _Earlier" Command="{Binding Timeline.MoveFrameLeftCommand}" />
          <MenuItem Header="Move Frame _Later" Command="{Binding Timeline.MoveFrameRightCommand}" />
          <Separator />
          <MenuItem Header="_Play / Pause" Command="{Binding Timeline.Playback.ToggleCommand}" />
          <MenuItem Header="_Previous Frame" Command="{Binding Timeline.Playback.StepBackCommand}" />
          <MenuItem Header="_Next Frame" Command="{Binding Timeline.Playback.StepForwardCommand}" />
          <Separator />
          <MenuItem Header="Name an A_nimation" Command="{Binding Timeline.AddTagCommand}" />
          <Separator />
          <MenuItem Header="_Onion Skin"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CanvasSettings.OnionSkin.IsEnabled, Mode=TwoWay}" />
        </MenuItem>

        <MenuItem Header="_Layer">
          <MenuItem Header="_New Layer" Command="{Binding Layers.AddLayerCommand}" />
          <MenuItem Header="_Duplicate Layer" Command="{Binding Layers.DuplicateLayerCommand}" />
          <MenuItem Header="De_lete Layer" Command="{Binding Layers.DeleteLayerCommand}" />
          <Separator />
          <MenuItem Header="Move _Up" Command="{Binding Layers.MoveLayerUpCommand}" />
          <MenuItem Header="Move _Down" Command="{Binding Layers.MoveLayerDownCommand}" />
        </MenuItem>

        <MenuItem Header="_View">
          <!-- These four carry no InputGesture: the shortcuts are handled in code-behind
               because Avalonia would render the raw key names ("Ctrl+OemPlus") here. -->
          <MenuItem Header="Zoom _In" Command="{Binding ZoomCommand}"
                    CommandParameter="{x:Static docking:CanvasZoomRequest.In}" />
          <MenuItem Header="Zoom _Out" Command="{Binding ZoomCommand}"
                    CommandParameter="{x:Static docking:CanvasZoomRequest.Out}" />
          <MenuItem Header="_Actual Size" Command="{Binding ZoomCommand}"
                    CommandParameter="{x:Static docking:CanvasZoomRequest.ActualSize}" />
          <MenuItem Header="Zoom to _Fit" Command="{Binding ZoomCommand}"
                    CommandParameter="{x:Static docking:CanvasZoomRequest.Fit}" />
          <Separator />
          <MenuItem Header="Show Pixel _Grid"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CanvasSettings.ShowPixelGrid, Mode=TwoWay}" />
          <MenuItem Header="Show _Rulers"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CanvasSettings.ShowRulers, Mode=TwoWay}" />
          <MenuItem Header="Show _Transparency Checks"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CanvasSettings.ShowTransparencyChecker, Mode=TwoWay}"
                    ToolTip.Tip="The grey chequered pattern behind the artwork, which marks the pixels that are not painted at all" />
          <MenuItem Header="Show Checks _On the Artwork"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CanvasSettings.ShowArtworkChecker, Mode=TwoWay}"
                    ToolTip.Tip="Lay the same chequered pattern over the pixels you have painted, as a texture. Separate from the pattern behind the artwork" />
          <MenuItem Header="Show Colour by the C_ursor"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CanvasSettings.ShowColorSwatchCursor, Mode=TwoWay}" />
          <Separator />
          <!-- One checkable entry per panel, driven by the panel table in XpDockFactory, so a
               panel added later appears here without this file changing. The checkmark shows
               what is actually on screen and toggling it affects only that one panel - the
               previous plain menu items rebuilt the whole default layout whenever a closed
               panel was asked for, which switched every other panel back on with it. -->
          <MenuItem Header="_Panels" ItemsSource="{Binding Panels}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                            x:DataType="vm:PanelToggleViewModel">
                <Setter Property="Header" Value="{Binding Title}" />
                <Setter Property="ToggleType" Value="CheckBox" />
                <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <!-- The layouts an artist can move between: the two the editor ships with, then
               whatever they have saved. Driven by one list on the view model, so a layout saved
               a moment ago is in this menu without anything here changing. -->
          <MenuItem Header="_Layouts" ItemsSource="{Binding Layouts}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                            x:DataType="vm:LayoutEntryViewModel">
                <Setter Property="Header" Value="{Binding Name}" />
                <Setter Property="Command" Value="{Binding ApplyCommand}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <MenuItem Header="_Save Current Layout…" Command="{Binding SaveLayoutAsCommand}"
                    ToolTip.Tip="Keep the panels as they are now under a name, to come back to later" />
          <MenuItem Header="_Manage Layouts…" Command="{Binding ManageLayoutsCommand}"
                    ToolTip.Tip="Rename, reorder and remove the layouts you have saved" />
          <MenuItem Header="Reset to _Default Layout" Command="{Binding ResetLayoutCommand}" />
          <Separator />
          <MenuItem Header="_Theme">
            <MenuItem Header="Follow _System"
                      ToggleType="Radio"
                      GroupName="Theme"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="{x:Static services:AppTheme.System}" />
            <MenuItem Header="_Light"
                      ToggleType="Radio"
                      GroupName="Theme"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="{x:Static services:AppTheme.Light}" />
            <MenuItem Header="_Dark"
                      ToggleType="Radio"
                      GroupName="Theme"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="{x:Static services:AppTheme.Dark}" />
          </MenuItem>
        </MenuItem>
      </Menu>

      <!-- ============================================================================
           Tool options
           ============================================================================ -->
      <Border DockPanel.Dock="Top" Classes="panel" Padding="8,5">
        <Grid ColumnDefinitions="*,Auto">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Brush" Classes="subtle" VerticalAlignment="Center" />
              <NumericUpDown Classes="optionNumber"
                             Value="{Binding Toolbox.ToolSettings.BrushSize, Mode=TwoWay}"
                             Minimum="1" Maximum="128" Increment="1"
                             FormatString="0" />
              <ComboBox ItemsSource="{x:Static vm:ToolboxViewModel.BrushShapes}"
                        SelectedItem="{Binding Toolbox.ToolSettings.BrushShape, Mode=TwoWay}"
                        Width="100" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Shape" Classes="subtle" VerticalAlignment="Center" />
              <CheckBox Content="Filled"
                        IsChecked="{Binding Toolbox.ToolSettings.IsShapeFilled, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Whether the rectangle and ellipse tools fill their shape or outline it" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Fill tolerance" Classes="subtle" VerticalAlignment="Center" />
              <NumericUpDown Classes="optionNumber"
                             Value="{Binding Toolbox.ToolSettings.FillTolerance, Mode=TwoWay}"
                             Minimum="0" Maximum="255" Increment="1"
                             FormatString="0" />
              <CheckBox Content="Contiguous"
                        IsChecked="{Binding Toolbox.ToolSettings.IsFillContiguous, Mode=TwoWay}"
                        VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Export scale" Classes="subtle" VerticalAlignment="Center" />
              <NumericUpDown Classes="optionNumber"
                             Value="{Binding ExportScale, Mode=TwoWay}"
                             Minimum="1" Maximum="16" Increment="1"
                             FormatString="0" />
            </StackPanel>

            <!-- The grid is on the options bar rather than only in the View menu because it
                 is switched off to check how the artwork actually reads, which is a thing an
                 artist does every few minutes and wants back immediately afterwards. Anything
                 reached that often should not be two clicks into a menu. -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="View" Classes="subtle" VerticalAlignment="Center" />
              <CheckBox Content="Grid"
                        IsChecked="{Binding CanvasSettings.ShowPixelGrid, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Draw the one-pixel grid over the artwork. Turn it off to see the image as it will be exported" />
              <CheckBox Content="Checks"
                        IsChecked="{Binding CanvasSettings.ShowTransparencyChecker, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="The grey chequered pattern behind the artwork, which marks the pixels that are not painted at all. Turn it off for a plain background" />
              <CheckBox Content="On art"
                        IsChecked="{Binding CanvasSettings.ShowArtworkChecker, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Lay the same chequered pattern over the pixels you have painted, as a texture over the colours" />

              <TextBlock Text="Zoom speed" Classes="subtle" VerticalAlignment="Center" Margin="8,0,0,0" />
              <Slider Width="90"
                      Minimum="0.25" Maximum="3"
                      TickFrequency="0.25"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      Value="{Binding CanvasSettings.ZoomSpeed, Mode=TwoWay}"
                      ToolTip.Tip="How far one wheel notch or one zoom command travels" />
            </StackPanel>

          </StackPanel>

          <!-- The way back, always visible. Buried in a menu, "reset the layout" is something
               an artist has to already know exists at the moment they most need it - which is
               when the panels are in a state they cannot undo by hand. -->
          <Button Grid.Column="1"
                  Command="{Binding ResetLayoutCommand}"
                  VerticalAlignment="Center"
                  Padding="8,3"
                  ToolTip.Tip="Put every panel back where it started, keeping all open documents">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="M4 4 L4 20 L20 20 L20 4 Z M4 9 L20 9 M15 9 L15 20"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.5"
                    StrokeJoin="Round"
                    Width="15" Height="15"
                    Stretch="Uniform"
                    VerticalAlignment="Center" />
              <TextBlock Text="Default layout" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

        </Grid>
      </Border>

      <!-- ============================================================================
           Status bar
           ============================================================================ -->
      <Border DockPanel.Dock="Bottom" Classes="panel" Padding="8,4">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="subtle" />

          <!-- Why the drawing tools are currently doing nothing. Every one of these states
               used to fail silently, which reads as the tool being broken. -->
          <TextBlock Grid.Column="1"
                     Text="{Binding EditabilityWarning}"
                     IsVisible="{Binding HasEditabilityWarning}"
                     Foreground="{DynamicResource XpAccentBrush}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis"
                     Margin="14,0" />

          <!-- Each number in its own fixed-width box, so neither label moves as the digits
               change width. A readout that twitches while the pointer moves is harder to read
               than one that is a little wider than it needs to be. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0"
                      VerticalAlignment="Center">
            <TextBlock Text="x" Classes="subtle" VerticalAlignment="Center" />
            <Border Classes="statusValue">
              <TextBlock Text="{Binding HoveredXText}" Classes="subtle" TextAlignment="Center" />
            </Border>
            <TextBlock Text="y" Classes="subtle" VerticalAlignment="Center" Margin="4,0,0,0" />
            <Border Classes="statusValue">
              <TextBlock Text="{Binding HoveredYText}" Classes="subtle" TextAlignment="Center" />
            </Border>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding DocumentSizeText}" Classes="subtle" Margin="12,0" />
          <TextBlock Grid.Column="4" Text="{Binding ZoomText}" Classes="subtle" Margin="12,0" />
        </Grid>
      </Border>

      <!-- ============================================================================
           The dockable workspace: panels and document tabs
           ============================================================================ -->
      <dock:DockControl Layout="{Binding Layout}" Factory="{Binding Factory}" />

    </DockPanel>

    <!-- ==============================================================================
         Modal overlay. Hit-testing the scrim is what makes the dialog modal: it swallows
         every click aimed at the editor beneath.
         ============================================================================== -->
    <Border Background="{DynamicResource XpScrimBrush}"
            IsVisible="{Binding Dialogs.IsOpen}">
      <ContentControl Content="{Binding Dialogs.Current}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Border>

  </Grid>

</UserControl>

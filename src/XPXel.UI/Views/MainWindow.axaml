<!--
  The desktop window.

  Its only job is to be a frame: it sets the title and hosts MainView, which is the actual
  user interface and is shared with the browser head. Keeping the window this thin is what
  guarantees the two platforms cannot drift apart.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XPXel.UI.Views"
        xmlns:vm="using:XPXel.UI.ViewModels"
        x:Class="XPXel.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280"
        Height="820"
        MinWidth="800"
        MinHeight="560"
        Background="{DynamicResource XpAppBackgroundBrush}">

  <views:MainView />

</Window>

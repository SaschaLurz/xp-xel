<!--
  The brush panel.

  Four settings and a preview of what they produce. The preview is not a drawing of a brush:
  it runs the same stamping code the tools do, so it is exactly the mark that will be left.

  Softness and stabilisation are labelled with what they each act on, because "smoothness"
  could plausibly mean either and getting the wrong one is a confusing few minutes. The note
  at the bottom names the tools that honour them - the pencil deliberately does not.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XPXel.UI.ViewModels"
             x:Class="XPXel.UI.Views.BrushPanelView"
             x:DataType="vm:BrushPanelViewModel">

  <ScrollViewer>
    <StackPanel Margin="8,6,8,10" Spacing="8">

      <!-- ============================================================================
           Preview and shape
           ============================================================================ -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

        <Border Grid.Column="0"
                Width="58" Height="58"
                Background="{DynamicResource XpThumbnailCheckerBrush}"
                BorderBrush="{DynamicResource XpPanelBorderBrush}"
                BorderThickness="1"
                ToolTip.Tip="The mark this brush leaves, at actual size">
          <!-- Nearest-neighbour, like everywhere else: a smoothed preview of a hard brush
               would show a soft edge the brush does not have. -->
          <Image Source="{Binding Preview}"
                 RenderOptions.BitmapInterpolationMode="None"
                 Stretch="None"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="SHAPE" Classes="panelHeader" Margin="0" />
          <ComboBox ItemsSource="{x:Static vm:BrushPanelViewModel.Shapes}"
                    SelectedItem="{Binding Settings.BrushShape, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <Button Content="Reset brush"
                  Command="{Binding ResetCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
        </StackPanel>

      </Grid>

      <!-- ============================================================================
           Size
           ============================================================================ -->
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="SIZE" Classes="panelHeader" Margin="0" />
          <TextBlock Grid.Column="1" Text="{Binding Settings.BrushSize}" Classes="subtle" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Slider Grid.Column="0"
                  Minimum="1" Maximum="64"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  Value="{Binding Settings.BrushSize, Mode=TwoWay}" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding Settings.BrushSize, Mode=TwoWay}"
                         Minimum="1" Maximum="128" Increment="1"
                         FormatString="0"
                         ShowButtonSpinner="False"
                         Width="52" />
        </Grid>

        <!-- Presets. The slider is for finding a size; these are for going straight back to
             one the artist already knows they want. -->
        <ItemsControl ItemsSource="{Binding SizePresets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BrushSizePreset">
              <Button Content="{Binding Size}"
                      Classes="preset"
                      Command="{Binding Apply}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- ============================================================================
           Softness - what one stamp looks like
           ============================================================================ -->
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="EDGE SOFTNESS" Classes="panelHeader" Margin="0" />
          <TextBlock Grid.Column="1" Text="{Binding Settings.BrushSoftness, StringFormat={}{0}%}" Classes="subtle" />
        </Grid>
        <Slider Minimum="0" Maximum="100"
                Value="{Binding Settings.BrushSoftness, Mode=TwoWay}"
                ToolTip.Tip="How far in from the rim the brush fades. 0% is a hard pixel-art edge." />
      </StackPanel>

      <!-- ============================================================================
           Stabilisation - where the stamps go
           ============================================================================ -->
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="STROKE STABILISATION" Classes="panelHeader" Margin="0" />
          <TextBlock Grid.Column="1" Text="{Binding Settings.BrushStabilization, StringFormat={}{0}%}" Classes="subtle" />
        </Grid>
        <Slider Minimum="0" Maximum="100"
                Value="{Binding Settings.BrushStabilization, Mode=TwoWay}"
                ToolTip.Tip="How much the pointer's path is smoothed before it is drawn. Steadies a shaky line." />
      </StackPanel>

      <TextBlock Classes="subtle"
                 TextWrapping="Wrap"
                 Text="Softness and stabilisation apply to the Brush and Eraser. The Pencil ignores both so that it always writes one exact colour into one exact pixel." />

    </StackPanel>
  </ScrollViewer>

</UserControl>

<!--
  XP-xel - shared control styles.

  Only styles that are genuinely reused across panels belong here. Anything specific to one
  view stays in that view, so a change to the layers panel cannot accidentally restyle the
  toolbox.

  All colours come from Themes/Tokens.axaml; nothing here names a literal colour.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- A docked panel: the toolbox, layers and colour areas. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource XpPanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XpPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The small heading above each panel section. -->
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="Foreground" Value="{DynamicResource XpSubtleForegroundBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="8,8,8,4" />
  </Style>

  <!-- Secondary text: hints, status readouts, units. -->
  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource XpSubtleForegroundBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- A toolbox button. Square, glyph-centred, and visibly selected when active. -->
  <Style Selector="ToggleButton.tool">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XpAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource XpAccentForegroundBrush}" />
  </Style>

  <!-- A palette swatch. Small, square, and tightly packed so many are visible at once. -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource XpPanelBorderBrush}" />
  </Style>

  <!-- The modal overlay behind a dialog. -->
  <Style Selector="Border.dialogSurface">
    <Setter Property="Background" Value="{DynamicResource XpPanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XpPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="MinWidth" Value="320" />
    <Setter Property="MaxWidth" Value="460" />
  </Style>

</Styles>

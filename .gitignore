## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ---------------------------------------------------------------------------------------
# XP-xel additions
#
# The block above is the standard Dotnet.gitignore. Everything below is specific to how
# this repository is laid out and to the editors the team uses. Keep new entries here so
# the upstream block stays easy to refresh from github/gitignore.
# ---------------------------------------------------------------------------------------

# IDE / editor state
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.user
*.suo
*.userprefs
*.sln.docstates

# Machine-generated launch profiles. Visual Studio writes these on first debug and bakes
# in a random localhost port, so they differ per machine and are pure noise in review.
**/Properties/launchSettings.json

# Publish output (desktop RID publishes and the WebAssembly bundle)
publish/
release/
[Pp]ublish/
*.publishsettings
*.pubxml.user

# Test / coverage results
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.trx
TestResults/

# Machine-local MSBuild overrides - never committed, always personal
*.local.props
*.local.targets
Directory.Build.local.props

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Scratch files produced while working on the project
*.tmp
*.bak

# AI session / prompt context scaffolding - local working notes, not project source
initial-prompt-context-info.txt

# Claude Code's per-machine settings: tool permissions granted on this machine, and nobody
# else's business. The shared .claude/settings.json and any skills stay tracked.
.claude/settings.local.json

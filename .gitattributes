# ---------------------------------------------------------------------------------------
# XP-xel - Git attributes
#
# XP-xel targets Windows, Linux, macOS and the browser, so contributors will be working on
# all three desktop operating systems. Normalising line endings in the repository (LF in
# git, native in the working tree) keeps diffs free of whole-file line-ending churn.
# ---------------------------------------------------------------------------------------

# Let git decide what is text, and normalise it to LF on commit.
* text=auto

# Source and project files, with language-aware diff hunk headers where git supports them.
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.axaml     text
*.xaml      text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.manifest  text

# Visual Studio refuses to load a solution file with LF endings.
*.sln       text eol=crlf

# Binary assets - never diff, never normalise.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.xpxel     binary

<!--
  ===================================================================================
  XP-xel — Central Package Management

  Purpose:
    Every NuGet package version used anywhere in the solution is declared exactly once,
    here. Individual .csproj files write <PackageReference Include="X" /> with NO
    Version attribute, and MSBuild resolves the version from this file.

  Why:
    With multiple projects and platform heads (desktop, browser, later mobile), version
    drift between projects is the classic source of "works on my head, breaks on yours"
    bugs. Central Package Management makes drift impossible.

  For future sessions:
    - Adding a package = add a <PackageVersion> line here + a <PackageReference> in the
      consuming project.
    - $(AvaloniaVersion) keeps every Avalonia package in lockstep. Avalonia packages
      MUST all be the same version or you get runtime type-load failures.
  ===================================================================================
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!-- Single source of truth for the Avalonia version. Bump here to upgrade the UI stack. -->
    <AvaloniaVersion>12.1.1</AvaloniaVersion>

    <!-- Dock ships one version per Avalonia version and pins Avalonia exactly, so this
         must track $(AvaloniaVersion). Upgrading Avalonia without upgrading Dock produces
         a NuGet downgrade error rather than a silent mismatch, which is the good outcome. -->
    <DockVersion>12.1.0.6</DockVersion>
  </PropertyGroup>

  <!-- ================================================================================
       UI stack (Avalonia)
       ================================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <!-- ================================================================================
       Docking (Dock.Avalonia)

       Provides the Visual Studio style shell: panels that can be dragged out, re-docked,
       tabbed together, floated and pinned. Dock.Model.Mvvm is the CommunityToolkit.Mvvm
       flavour of the model, which is the one that matches the rest of this codebase; the
       ReactiveUI flavour would drag in a second MVVM framework.

       Dock.Serializer.SystemTextJson persists the arrangement between sessions.
       ================================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Dock.Avalonia" Version="$(DockVersion)" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="$(DockVersion)" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="$(DockVersion)" />
    <PackageVersion Include="Dock.Serializer.SystemTextJson" Version="$(DockVersion)" />
    <PackageVersion Include="Dock.Settings" Version="$(DockVersion)" />
  </ItemGroup>

  <!-- ================================================================================
       Application infrastructure
       ================================================================================ -->
  <ItemGroup>
    <!-- Source-generated MVVM (ObservableProperty / RelayCommand). Chosen over ReactiveUI
         because it uses no runtime reflection, which keeps WebAssembly and future
         NativeAOT publishing viable. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <!-- ================================================================================
       Testing
       ================================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
